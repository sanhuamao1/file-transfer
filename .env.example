# 访问密码
ACCESS_CODE=your-secret-code-here

# 存储模式：local（本地文件）或 oss（阿里云 OSS）
STORAGE_BACKEND=local

# 本地存储路径（仅 STORAGE_BACKEND=local 时生效）
LOCAL_STORAGE_PATH=./storage

# 阿里云 OSS 配置（仅 STORAGE_BACKEND=oss 时需填写）
# OSS_ACCESS_KEY_ID=LTAI5txxxxxxxxxxxx
# OSS_ACCESS_KEY_SECRET=your-access-key-secret
# OSS_BUCKET_NAME=my-file-transfer-bucket
# OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com