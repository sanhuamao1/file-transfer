# 访问密码
ACCESS_CODE=your-secret-code-here

# 文件存储方式：留空或不设为本地磁盘，设为 true/1 启用 OSS
OSS_ENABLED=false

# 阿里云 OSS 配置（OSS_ENABLED=true 时必填）
OSS_ACCESS_KEY_ID=LTAI5txxxxxxxxxxxx
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_BUCKET_NAME=my-file-transfer-bucket
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
